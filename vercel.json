{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/panel-sw\\.js",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Service-Worker-Allowed": "/panel/"
      },
      "continue": true
    },
    {
      "src": "/central-hq(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/panel/(.*)",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/index\\.html",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000; includeSubDomains"
      },
      "continue": true
    },
    {
      "src": "/demo/admin(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/streetboss-crm(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/superadmin(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/streetboss-admin(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/demo-admin(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "src": "/internal(/.*)?",
      "status": 404,
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/menu/(.*)",
      "dest": "/api/menu"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
