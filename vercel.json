{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/central-hq(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/panel/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "routes": [
    { "src": "/demo/admin(/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/streetboss-crm(/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/superadmin(/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/streetboss-admin(/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/demo-admin(/.*)?", "status": 404, "dest": "/404.html" },
    { "src": "/internal(/.*)?", "status": 404, "dest": "/404.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
